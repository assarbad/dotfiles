# vim: set autoindent smartindent ts=4 sw=4 sts=4 noet filetype=sh:
# shellcheck shell=bash disable=SC2059,SC2154

# We depend on Debian/Ubuntu
[[ -f "/etc/debian_version" ]] || return

function prune-kernels
{
	if [[ $- == *i* ]]; then
		declare -A _colors=(
			[cR]='\e[1;31m'  [cG]='\e[1;32m'  [cB]='\e[1;34m'
			[cR_]='\e[0;31m' [cG_]='\e[0;32m' [cB_]='\e[0;34m'
			[cW]='\e[1;37m'  [cY]='\e[1;33m'
			[cW_]='\e[0;37m' [cY_]='\e[0;33m'
			[cZ]='\e[0m'
		)
		for _k in "${!_colors[@]}"; do
			  declare -p "$_k" &>/dev/null || local "$_k"="${_colors[$_k]}"
		done
	fi
	for tool in dpkg grep uname awk sort sed tail apt-get readlink rm; do type $tool > /dev/null 2>&1 || { printf -- "${cR}ERROR:${cZ} couldn't find ${cW}'%s'${cZ} which is required by this function.\n" "$tool"; return; }; done
	local VENDOR=0
	type dpkg-vendor > /dev/null 2>&1 && ((VENDOR++))
	if ((VENDOR)); then
		command dpkg-vendor --derives-from Debian || { printf -- "${cR}ERROR:${cZ} This has only been tested on Debian/Ubuntu.\n"; return; }
	fi
	[[ -f "/etc/debian_version" ]] || { printf -- "${cR}ERROR:${cZ} This has only been tested on Debian/Ubuntu.\n"; return; }
	[[ "$UID" -eq "0" ]] || local SUDO=sudo
	local RUNKRNL
	RUNKRNL=$(uname -r)
	if command dpkg -l|command grep ^ii|command grep "$(command dpkg --print-architecture)"|command grep -q pve-kernel; then
		printf -- "Assuming we run on Proxmox VE (PVE) based on presence of pve-kernel packages\n"
		local -a _krnls PACKAGES
		local NOWKRNL
		mapfile -t _krnls < <(command dpkg -l|command grep ^ii|command grep "$(command dpkg --print-architecture)"|command grep pve-kernel|command grep -Fv "pve-kernel-$RUNKRNL"|command awk '{print $2}'|command sort -V)
		NOWKRNL=${_krnls[-1]#pve-kernel-}
		PACKAGES=("${_krnls[@]:0:${#_krnls[@]}-1}")
		printf -- "${cG}Skipping ${cY}the following kernels:${cZ} %s" "$NOWKRNL"
		[[ "$RUNKRNL" == "$NOWKRNL" ]] || { printf -- ", %s" "$RUNKRNL"; }
		printf -- " (${cG}currently running${cZ})\n"
		if [[ ${#PACKAGES[@]} -gt 0 ]]; then
			printf -- "${cG}[STEP 1] ${cY}Removing packages${cZ}\n"
			$SUDO apt-get $APTGET_YES --purge autoremove "${PACKAGES[@]}" || { printf -- "${cR}Seems that ${cW}apt-get${cR} was not successful, aborting.${cZ}\n"; return; }
		else
			printf -- "${cG}No packages need to be removed.${cZ}\n"
		fi
	else
		VMLINUZ="/vmlinuz"
		if [[ ! -L "$VMLINUZ" ]]; then
			VMLINUZ="/boot/vmlinuz"
			if [[ ! -L "$VMLINUZ" ]]; then
				printf -- "${cR}ERROR:${cZ} Expected ${cW}%s${cZ} to exist in ${cW}/${cZ} or ${cW}/boot${cZ}.\n" "${VMLINUZ##*/}"
				return
			fi
		fi
		# Figure out the name of the newest and the previous kernel
		local OLDKRNL NOWKRNL VERSIONS PACKAGES FILES
		local -a LINUXINCLUDES
		OLDKRNL=$(readlink -f "${VMLINUZ}.old")
		NOWKRNL=$(readlink -f "${VMLINUZ}")
		[[ -L "${VMLINUZ}.old" ]] || OLDKRNL="$NOWKRNL"
		# Strip path
		OLDKRNL="${OLDKRNL##*/vmlinuz-}"
		NOWKRNL="${NOWKRNL##*/vmlinuz-}"
		# If the running kernel is newer than the symlink (stale /vmlinuz), demote the symlink kernel to "old"
		if [[ "$RUNKRNL" != "$NOWKRNL" ]] && [[ "$(printf '%s\n' "$NOWKRNL" "$RUNKRNL" | sort -V | tail -n 1)" == "$RUNKRNL" ]]; then
			OLDKRNL="$NOWKRNL"
			NOWKRNL="$RUNKRNL"
		fi
		# --old: also prune the old-symlink kernel; collapse old==new so only NOWKRNL is skipped
		[[ "$1" == "--old" ]] && OLDKRNL="$NOWKRNL"
		# shellcheck disable=SC2046
		VERSIONS=$(echo $(for krnl in /boot/vmlinuz-*; do echo "${krnl##*/vmlinuz-}"; done) $(command dpkg -l|awk '/^ii/ && $2~/^linux-image-[0-9]+\.[0-9]/{sub(/^linux-image-/,"",$2);print $2}')|sort|uniq|sed -e "s:$NOWKRNL::g;s:$OLDKRNL::g;s:$RUNKRNL::g")
		printf -- "${cG}Skipping ${cY}the following kernels:${cZ} %s" "$NOWKRNL"
		[[ "$RUNKRNL" == "$NOWKRNL" ]] || { printf -- ", %s" "$RUNKRNL"; }
		[[ "$OLDKRNL" == "$NOWKRNL" ]] || printf -- ", %s (${cY}old kernel${cZ})" "$OLDKRNL"
		printf -- " (${cG}currently running${cZ})\n"
		# Remove packages
		PACKAGES=$(for i in $VERSIONS; do
				dpkg -l "linux-*-$i" 2>/dev/null | awk '/^ii/ { print $2 }'
			done)
		if [[ -n "$PACKAGES" ]]; then
			printf -- "${cG}[STEP 1] ${cY}Removing packages${cZ}\n"
			# shellcheck disable=SC2086
			$SUDO apt-get $APTGET_YES --purge autoremove $PACKAGES || { printf -- "${cR}Seems that ${cW}apt-get${cR} was not successful, aborting.${cZ}\n"; return; }
		else
			printf -- "${cG}No packages need to be removed.${cZ}\n"
		fi
		# Remove any remaining kernel images etc from /boot
		FILES=$(for fname in $(for i in $VERSIONS; do echo -n "/boot/abi-$i /boot/initrd.img-$i config-$i System.map-$i vmcoreinfo-$i vmlinuz-$i "; done); do [[ -f "$fname" ]] && { echo -n "$fname "; }; done)
		if [[ -n "$FILES" ]]; then
			printf -- "${cG}[STEP 2] ${cY}Now removing remaining files:${cZ} %s\n" "$FILES"
			# shellcheck disable=SC2086
			$SUDO rm -f -- $FILES
		else
			printf -- "${cG}Nothing else to clean up.${cZ}\n"
		fi
		mapfile -t LINUXINCLUDES < <($SUDO apt-get --assume-no --just-print --purge autoremove 2>&1|awk '/^Purg/{print $2}')
		if [[ ${#LINUXINCLUDES[@]} -gt 0 ]]; then
			printf -- "${cG}Remove remaining packages with: ${SUDO} apt-get --purge autoremove${cZ}\n"
			printf -- "  (packages: %s)\n" "${LINUXINCLUDES[*]}"
		fi
		printf -- "If you want to purge the uninstalled packages as well, use:\n"
		printf -- "\t${cW}apt-get purge \$(dpkg -l|awk '\$1 ~ /^rc/ && \$2 ~ /^linux-(headers|image|modules|modules-extra)/ {print \$2}')${cZ}\n"
		printf -- "... or:\n"
		printf -- "\t${cW}apt autopurge${cZ}\n"
	fi
}
