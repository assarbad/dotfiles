# vim: set autoindent smartindent ts=4 sw=4 sts=4 noet filetype=sh:

if "${WHENCE_CMD[@]}" sha1sum > /dev/null 2>&1 && "${WHENCE_CMD[@]}" sed > /dev/null 2>&1; then
	function gen-mac()
	{
		if [[ -n "$1" ]]; then
			local OID="00:16:3e"
			local RAND
			RAND=$(printf '%s' "$1" | sha1sum | sed 's/\(..\)\(..\)\(..\).*/\1:\2:\3/')
			printf '%s\n' "$OID:$RAND"
		else
			printf '%s\n' "ERROR: please supply hostname to create MAC address from, e.g.:"
			printf '       %s myhost\n' "$FUNCNAME"
		fi
	}
fi
