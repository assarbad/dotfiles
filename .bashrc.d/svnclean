# vim: set autoindent smartindent ts=4 sw=4 sts=4 noet filetype=sh:

if "${WHENCE_CMD[@]}" svn > /dev/null 2>&1 && "${WHENCE_CMD[@]}" grep > /dev/null 2>&1 && "${WHENCE_CMD[@]}" cut > /dev/null 2>&1 && "${WHENCE_CMD[@]}" rm > /dev/null 2>&1; then
	function svnclean
	{
		svn status --no-ignore | grep '^[I?]' | cut -c 9- | while IFS= read -r f; do rm -rf "$f"; done
	}
fi
